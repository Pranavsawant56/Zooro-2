# SMTP account used to send enquiries (e.g. the info@ mailbox on your host).
SMTP_HOST=mail.zoorohospitality.com
SMTP_PORT=465
# true for port 465, false for 587/25
SMTP_SECURE=true
SMTP_USER=info@zoorohospitality.com
SMTP_PASS=your-mailbox-password

# Where enquiries should arrive, and the visible From address.
ENQUIRY_TO_EMAIL=info@zoorohospitality.com
ENQUIRY_FROM_EMAIL="ZOORO Website <info@zoorohospitality.com>"

# Comma-separated list of sites allowed to post here. Leave empty to allow any
# origin (not recommended once the site is live).
ALLOWED_ORIGINS=https://www.zoorohospitality.com,https://zoorohospitality.com

# Port the service listens on (most hosts inject PORT).
PORT=8787
