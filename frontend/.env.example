# Website build settings (copy to .env.local)
#
# NEXT_PUBLIC_* values are inlined into the exported HTML/JS at build time, so
# changing them requires a rebuild (`npm run build`).

# URL of the nodemailer service in `backend/` (see its README).
# Required: without it the enquiry forms show an error instead of sending.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=https://mail.zoorohospitality.com/enquiry

# Local development uses .env.development.local, which points at
# http://localhost:8000/enquiry while you run the mail service locally.

# SMTP credentials do NOT belong here. They live in `backend/.env`, which
# is git-ignored and only used by the separately hosted mail service.
